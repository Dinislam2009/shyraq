generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  tasks            Task[]
  projects         Project[]
  habits           Habit[]
  habitCompletions HabitCompletion[]
  focusSessions    FocusSession[]
  flashcardDecks   FlashcardDeck[]
  @@map("users")
}

model Project {
  id          String   @id @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  name        String
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  @@index([userId, archivedAt])
  @@map("projects")
}

model Task {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid @map("user_id")
  projectId    String?   @db.Uuid @map("project_id")
  title        String
  description  String?
  status       String    @default("TODO")
  priority     String    @default("NONE")
  dueAt        DateTime? @map("due_at")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([projectId])
  @@map("tasks")
}

model Habit {
  id          String            @id @db.Uuid
  userId      String            @db.Uuid @map("user_id")
  title       String
  description String?
  frequency   String            @default("DAILY")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  archivedAt  DateTime?         @map("archived_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
  @@index([userId, archivedAt])
  @@map("habits")
}

model HabitCompletion {
  id        String   @id @db.Uuid
  habitId   String   @db.Uuid @map("habit_id")
  userId    String   @db.Uuid @map("user_id")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_completions")
}

model FocusSession {
  id              String    @id @db.Uuid
  userId          String    @db.Uuid @map("user_id")
  taskId          String?   @db.Uuid @map("task_id")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  status          String    @default("RUNNING")
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([taskId])
  @@map("focus_sessions")
}

model FlashcardDeck {
  id          String       @id @db.Uuid
  userId      String       @db.Uuid @map("user_id")
  name        String
  description String?
  archivedAt  DateTime?    @map("archived_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Flashcard[]
  @@index([userId, archivedAt])
  @@map("flashcard_decks")
}

model Flashcard {
  id          String        @id @db.Uuid
  deckId      String        @db.Uuid @map("deck_id")
  front       String
  back        String
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deck        FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  @@index([deckId, position])
  @@map("flashcards")
}

model SyncOperation {
  sequence    BigInt   @id @default(autoincrement())
  operationId String   @unique @db.Uuid @map("operation_id")
  userId      String   @db.Uuid @map("user_id")
  entityType  String   @map("entity_type")
  entityId    String   @db.Uuid @map("entity_id")
  operation   String
  version     Int
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([userId, sequence])
  @@index([userId, entityType, entityId])
  @@map("sync_operations")
}
