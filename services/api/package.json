    "@supabase/supabase-js": "2.112.4",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.3",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "7.9.1",
    "tsx": "^4.20.3"
  }
}
